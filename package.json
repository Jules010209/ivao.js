{
  "name": "ivao.js",
  "version": "2.0.0",
  "description": "Typed Node.js client for the whole IVAO API (data, core, tracker, oauth, mtl, flight plans, webeye, status, atc bookings, events, auto-atis), generated from the official OpenAPI documents.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=16"
  },
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jules010209/ivao.js.git"
  },
  "scripts": {
    "fetch-specs": "node tools/fetch-specs.js",
    "generate": "node tools/generate.js",
    "build": "npm run generate && tsc",
    "test": "node test/smoke.test.js"
  },
  "keywords": [
    "ivao",
    "nodejs",
    "api",
    "typescript",
    "ivao.js",
    "whazzup",
    "flight-simulation"
  ],
  "author": "Jules010209",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/Jules010209/ivao.js/issues"
  },
  "homepage": "https://github.com/Jules010209/ivao.js#readme",
  "dependencies": {
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.1.0",
    "typescript": "^5.4.0"
  }
}
